#!/bin/sh
set -eu
umask 077

ACCOUNT="/home/storage/781/4477781/user"
WEBAPP="$ACCOUNT/webapp"
STATE="$ACCOUNT/.powerpc-control-v1"
DAEMON="$STATE/daemon.py"
PIDFILE="$STATE/daemon.pid"
PUBLIC_STATUS="$ACCOUNT/htdocs/.well-known/powerpc-control-v1/status.json"
DISABLED="$STATE/disabled"
LOCKFILE="$STATE/service.lock"
LOG="$STATE/service.log"
DELEGATION_STATE="$ACCOUNT/.continuity-delegation"
DELEGATION_ACCEPTANCE="$DELEGATION_STATE/CONTINUITY_AGENT_DELEGATION_ACCEPTANCE_20261001.json"
DELEGATION_VERIFY="$WEBAPP/bin/verify-continuity-delegation"
CAGENT_WATCH_STATE="$STATE/cagent-watch.state"
CAGENT_WATCH_INTERVAL="${PPC_CONTROL_CAGENT_WATCH_SECONDS:-300}"

PY=""
for p in \
  "$WEBAPP/miniconda/bin/python3.12" \
  "$WEBAPP/miniconda/bin/python3" \
  "$WEBAPP/envs/open-terminal/bin/python"
do
  if [ -x "$p" ]; then PY="$p"; break; fi
done
[ -n "$PY" ] || { echo "python runtime unavailable" >&2; exit 2; }

alive() {
  [ -s "$PIDFILE" ] || return 1
  pid="$(cat "$PIDFILE" 2>/dev/null || true)"
  [ -n "$pid" ] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  [ -r "/proc/$pid/cmdline" ] || return 1
  tr '\\000' ' ' <"/proc/$pid/cmdline" | grep -F -- "$DAEMON" >/dev/null 2>&1
}

heartbeat_age() {
  [ -s "$PUBLIC_STATUS" ] || { echo -1; return 0; }
  "$PY" - "$PUBLIC_STATUS" <<'PY'
import json,sys,time
try:
    d=json.load(open(sys.argv[1]))
    h=int(d.get("heartbeat_at",0))
    print(max(0,int(time.time())-h) if h else -1)
except Exception:
    print(-1)
PY
}

healthy() {
  alive || return 1
  age="$(heartbeat_age)"
  case "$age" in
    ''|-1) return 1 ;;
    *) [ "$age" -le 75 ] ;;
  esac
}

wait_healthy() {
  n=0
  while [ "$n" -lt 30 ]; do
    if alive; then
      age="$(heartbeat_age)"
      case "$age" in
        ''|-1) ;;
        *) [ "$age" -le 75 ] && return 0 ;;
      esac
    fi
    n=$((n+1))
    sleep 1
  done
  return 1
}

stop_one() {
  if alive; then
    pid="$(cat "$PIDFILE")"
    kill "$pid" 2>/dev/null || true
    n=0
    while kill -0 "$pid" 2>/dev/null && [ "$n" -lt 15 ]; do
      n=$((n+1))
      sleep 1
    done
    if kill -0 "$pid" 2>/dev/null && [ -r "/proc/$pid/cmdline" ] && \
       tr '\\000' ' ' <"/proc/$pid/cmdline" | grep -F -- "$DAEMON" >/dev/null 2>&1; then
      kill -9 "$pid" 2>/dev/null || true
    fi
  fi
  rm -f "$PIDFILE"
}

start_one() {
  [ -x "$DAEMON" ] || { echo "control daemon missing: $DAEMON" >&2; return 2; }
  mkdir -p "$STATE"
  chmod 700 "$STATE"
  rm -f "$DISABLED"
  if alive; then return 0; fi
  rm -f "$PIDFILE"

  (
    exec 9>&-
    cd "$WEBAPP"
    if command -v setsid >/dev/null 2>&1; then
      exec setsid "$PY" "$DAEMON"
    else
      exec "$PY" "$DAEMON"
    fi
  ) </dev/null >>"$LOG" 2>&1 &

  wait_healthy
}

do_ensure() {
  [ ! -e "$DISABLED" ] || return 0
  mkdir -p "$STATE"
  chmod 700 "$STATE"
  exec 9>"$LOCKFILE"
  if command -v flock >/dev/null 2>&1; then
    flock -n 9 || return 0
  fi
  if healthy; then
    cagent_watch || true
    return 0
  fi
  if alive; then
    echo "POWERPC_CONTROL=STALE_RECOVERY heartbeat_age=$(heartbeat_age)" >>"$LOG"
    stop_one
  fi
  start_one
  cagent_watch || true
}

diagnose_task() {
  task_id="${1:-}"
  [ -n "$task_id" ] || { echo "diagnose requires task_id" >&2; return 2; }
  "$PY" - "$STATE" "$task_id" <<'PY'
import json,sqlite3,sys
from pathlib import Path
state=Path(sys.argv[1]); task_id=sys.argv[2]
db=state/"state.sqlite3"; log=state/"daemon.log"
row=None
if db.exists():
    con=sqlite3.connect(f"file:{db}?mode=ro",uri=True)
    row=con.execute(
        "SELECT task_id,envelope_sha256,state,received_at,completed_at,result_path "
        "FROM tasks WHERE task_id=?",(task_id,)
    ).fetchone()
    con.close()
events=[]
if log.exists():
    for line in log.read_text(errors="replace").splitlines():
        if task_id in line:
            events.append(line)
events=events[-20:]
result=state.parent/"htdocs"/".well-known"/"powerpc-control-v1"/"results"/(task_id+".json")
if row:
    st=str(row[2] or "").lower()
    if st=="publish_failed":
        classification="PUBLISH_FAILED"
    elif st=="claimed":
        classification="CLAIMED_STALLED"
    elif st=="completed":
        classification="COMPLETED"
    elif st=="failed":
        classification="EXECUTION_FAILED"
    elif st=="expired":
        classification="EXPIRED"
    elif st=="needs_authority":
        classification="NEEDS_AUTHORITY"
    else:
        classification="ADMITTED_"+st.upper()
elif any("decrypt_reject="+task_id+":" in x for x in events):
    classification="DECRYPT_REJECT"
elif any("task_conflict="+task_id in x for x in events):
    classification="TASK_CONFLICT"
elif any("publish_error="+task_id+":" in x for x in events):
    classification="PUBLISH_FAILED_LOG_ONLY"
elif result.exists():
    classification="RESULT_WITHOUT_DB_ROW"
else:
    classification="NOT_OBSERVED"
out={
    "task_id":task_id,
    "classification":classification,
    "db":None if row is None else {
        "envelope_sha256":row[1],
        "state":row[2],
        "received_at":row[3],
        "completed_at":row[4],
        "result_path":row[5],
    },
    "local_result_exists":result.exists(),
    "log_events":events,
}
print(json.dumps(out,sort_keys=True,separators=(",",":")))
PY
}

cagent_status() {
  [ -x "$DELEGATION_VERIFY" ] || {
    echo "INTER_AGENT_CONTROL_PLANE=UNVERIFIED"
    echo "reason=delegation_verifier_missing"
    return 5
  }
  [ -s "$DELEGATION_ACCEPTANCE" ] || {
    echo "INTER_AGENT_CONTROL_PLANE=UNVERIFIED"
    echo "reason=delegation_acceptance_checkpoint_missing"
    return 5
  }

  "$PY" - "$DELEGATION_ACCEPTANCE" "$DELEGATION_VERIFY" <<'PY'
import json,subprocess,sys
checkpoint_path,verifier=sys.argv[1:3]
try:
    checkpoint=json.load(open(checkpoint_path,encoding="utf-8"))
    first=(checkpoint.get("outer_first") or {}).get("task_id")
    retry=(checkpoint.get("outer_retry") or {}).get("task_id")
    nested=(checkpoint.get("nested") or {}).get("task_id")
    expected=checkpoint.get("evidence_fingerprint")
    if not all(isinstance(x,str) and x for x in (first,retry,nested,expected)):
        raise ValueError("checkpoint fields missing")
    p=subprocess.run(
        [sys.executable,verifier,
         "--outer-first",first,
         "--outer-retry",retry,
         "--nested-task",nested,
         "--json"],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        timeout=20,
        check=False,
    )
    if p.returncode != 0:
        print("INTER_AGENT_CONTROL_PLANE=UNVERIFIED")
        print("CONTINUITY_AGENT_DELEGATION_ACCEPTANCE=FAIL")
        if p.stdout.strip():
            print("verifier_output="+p.stdout.strip().replace("\n"," ")[:1200])
        if p.stderr.strip():
            print("verifier_error="+p.stderr.strip().replace("\n"," ")[:1200])
        raise SystemExit(6)
    live=json.loads(p.stdout)
    if live.get("acceptance")!="PASS":
        raise ValueError("live verifier did not pass")
    if live.get("evidence_fingerprint")!=expected:
        print("INTER_AGENT_CONTROL_PLANE=DRIFT")
        print("CONTINUITY_AGENT_DELEGATION_ACCEPTANCE=FAIL")
        print("expected_fingerprint="+str(expected))
        print("live_fingerprint="+str(live.get("evidence_fingerprint")))
        raise SystemExit(7)
    print("INTER_AGENT_CONTROL_PLANE=ACCEPTED")
    print("CONTINUITY_AGENT_DELEGATION_ACCEPTANCE=PASS")
    print("MODEL_ID="+str((live.get("nested") or {}).get("model_id")))
    print("EVIDENCE_FINGERPRINT="+expected)
except subprocess.TimeoutExpired:
    print("INTER_AGENT_CONTROL_PLANE=UNVERIFIED")
    print("reason=delegation_verifier_timeout")
    raise SystemExit(8)
except SystemExit:
    raise
except Exception as e:
    print("INTER_AGENT_CONTROL_PLANE=UNVERIFIED")
    print("reason="+type(e).__name__+":"+str(e)[:500])
    raise SystemExit(9)
PY
}

cagent_watch() {
  force="${1:-0}"
  now="$(date +%s)"
  case "$CAGENT_WATCH_INTERVAL" in
    ''|*[!0-9]*) interval=300 ;;
    *) interval="$CAGENT_WATCH_INTERVAL" ;;
  esac

  if [ "$force" != "1" ] && [ -s "$CAGENT_WATCH_STATE" ]; then
    last="$("$PY" - "$CAGENT_WATCH_STATE" <<'PY'
import sys
try:
    for line in open(sys.argv[1],encoding="utf-8"):
        if line.startswith("checked_at="):
            print(int(line.split("=",1)[1].strip()))
            break
    else:
        print(0)
except Exception:
    print(0)
PY
)"
    case "$last" in ''|*[!0-9]*) last=0 ;; esac
    [ $((now-last)) -ge "$interval" ] || return 0
  fi

  if output="$(cagent_status 2>&1)"; then
    rc=0
  else
    rc=$?
  fi
  state="$(printf '%s\n' "$output" | sed -n 's/^INTER_AGENT_CONTROL_PLANE=//p' | head -n 1)"
  [ -n "$state" ] || state="UNVERIFIED"
  fingerprint="$(printf '%s\n' "$output" | sed -n 's/^EVIDENCE_FINGERPRINT=//p' | head -n 1)"

  previous=""
  if [ -s "$CAGENT_WATCH_STATE" ]; then
    previous="$(sed -n 's/^state=//p' "$CAGENT_WATCH_STATE" | head -n 1)"
  fi

  tmp="$CAGENT_WATCH_STATE.$"
  {
    echo "checked_at=$now"
    echo "state=$state"
    echo "rc=$rc"
    echo "fingerprint=$fingerprint"
  } >"$tmp"
  chmod 600 "$tmp"
  mv "$tmp" "$CAGENT_WATCH_STATE"

  if [ "$state" != "$previous" ]; then
    printf '%s CAGENT_CONTROL=%s rc=%s fingerprint=%s\n'       "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$state" "$rc" "$fingerprint" >>"$LOG"
  fi

  [ "$rc" -eq 0 ]
}

case "${1:-ensure}" in
  ensure)
    do_ensure
    ;;
  start|enable)
    mkdir -p "$STATE"
    chmod 700 "$STATE"
    rm -f "$DISABLED"
    do_ensure
    ;;
  status)
    if alive; then
      age="$(heartbeat_age)"
      if healthy; then
        echo "POWERPC_CONTROL=RUNNING pid=$(cat "$PIDFILE") heartbeat_age=$age"
        exit 0
      fi
      echo "POWERPC_CONTROL=STALE pid=$(cat "$PIDFILE") heartbeat_age=$age"
      exit 4
    fi
    if [ -e "$DISABLED" ]; then
      echo "POWERPC_CONTROL=DISABLED"
      exit 3
    fi
    echo "POWERPC_CONTROL=STOPPED"
    exit 1
    ;;
  diagnose)
    diagnose_task "${2:-}"
    ;;
  cagent-status)
    cagent_status
    ;;
  cagent-watch)
    cagent_watch 1
    cat "$CAGENT_WATCH_STATE"
    ;;
  restart)
    mkdir -p "$STATE"
    chmod 700 "$STATE"
    rm -f "$DISABLED"
    exec 9>"$LOCKFILE"
    if command -v flock >/dev/null 2>&1; then flock 9; fi
    stop_one
    start_one
    ;;
  stop|disable)
    mkdir -p "$STATE"
    chmod 700 "$STATE"
    : >"$DISABLED"
    chmod 600 "$DISABLED"
    exec 9>"$LOCKFILE"
    if command -v flock >/dev/null 2>&1; then flock 9; fi
    stop_one
    ;;
  *)
    echo "usage: $0 [ensure|start|enable|status|diagnose <task_id>|cagent-status|cagent-watch|restart|stop|disable]" >&2
    exit 2
    ;;
esac
