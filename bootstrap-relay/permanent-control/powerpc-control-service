#!/bin/sh
set -eu
umask 077

ACCOUNT="/home/storage/781/4477781/user"
WEBAPP="$ACCOUNT/webapp"
STATE="$ACCOUNT/.powerpc-control-v1"
DAEMON="$STATE/daemon.py"
PIDFILE="$STATE/daemon.pid"
PUBLIC_STATUS="$ACCOUNT/htdocs/.well-known/powerpc-control-v1/status.json"
DISABLED="$STATE/disabled"
LOCKFILE="$STATE/service.lock"
LOG="$STATE/service.log"

PY=""
for p in \
  "$WEBAPP/miniconda/bin/python3.12" \
  "$WEBAPP/miniconda/bin/python3" \
  "$WEBAPP/envs/open-terminal/bin/python"
do
  if [ -x "$p" ]; then PY="$p"; break; fi
done
[ -n "$PY" ] || { echo "python runtime unavailable" >&2; exit 2; }

alive() {
  [ -s "$PIDFILE" ] || return 1
  pid="$(cat "$PIDFILE" 2>/dev/null || true)"
  [ -n "$pid" ] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  [ -r "/proc/$pid/cmdline" ] || return 1
  tr '\\000' ' ' <"/proc/$pid/cmdline" | grep -F -- "$DAEMON" >/dev/null 2>&1
}

heartbeat_age() {
  [ -s "$PUBLIC_STATUS" ] || { echo -1; return 0; }
  "$PY" - "$PUBLIC_STATUS" <<'PY'
import json,sys,time
try:
    d=json.load(open(sys.argv[1]))
    h=int(d.get("heartbeat_at",0))
    print(max(0,int(time.time())-h) if h else -1)
except Exception:
    print(-1)
PY
}

wait_healthy() {
  n=0
  while [ "$n" -lt 30 ]; do
    if alive; then
      age="$(heartbeat_age)"
      case "$age" in
        ''|-1) ;;
        *) [ "$age" -le 75 ] && return 0 ;;
      esac
    fi
    n=$((n+1))
    sleep 1
  done
  return 1
}

stop_one() {
  if alive; then
    pid="$(cat "$PIDFILE")"
    kill "$pid" 2>/dev/null || true
    n=0
    while kill -0 "$pid" 2>/dev/null && [ "$n" -lt 15 ]; do
      n=$((n+1))
      sleep 1
    done
    if kill -0 "$pid" 2>/dev/null && [ -r "/proc/$pid/cmdline" ] && \
       tr '\\000' ' ' <"/proc/$pid/cmdline" | grep -F -- "$DAEMON" >/dev/null 2>&1; then
      kill -9 "$pid" 2>/dev/null || true
    fi
  fi
  rm -f "$PIDFILE"
}

start_one() {
  [ -x "$DAEMON" ] || { echo "control daemon missing: $DAEMON" >&2; return 2; }
  mkdir -p "$STATE"
  chmod 700 "$STATE"
  rm -f "$DISABLED"
  if alive; then return 0; fi
  rm -f "$PIDFILE"

  (
    exec 9>&-
    cd "$WEBAPP"
    if command -v setsid >/dev/null 2>&1; then
      exec setsid "$PY" "$DAEMON"
    else
      exec "$PY" "$DAEMON"
    fi
  ) </dev/null >>"$LOG" 2>&1 &

  wait_healthy
}

do_ensure() {
  [ ! -e "$DISABLED" ] || return 0
  mkdir -p "$STATE"
  chmod 700 "$STATE"
  exec 9>"$LOCKFILE"
  if command -v flock >/dev/null 2>&1; then
    flock -n 9 || return 0
  fi
  if alive; then return 0; fi
  start_one
}

case "${1:-ensure}" in
  ensure)
    do_ensure
    ;;
  start|enable)
    mkdir -p "$STATE"
    chmod 700 "$STATE"
    rm -f "$DISABLED"
    do_ensure
    ;;
  status)
    if alive; then
      age="$(heartbeat_age)"
      echo "POWERPC_CONTROL=RUNNING pid=$(cat "$PIDFILE") heartbeat_age=$age"
      case "$age" in
        ''|-1) exit 4 ;;
        *) [ "$age" -le 75 ] && exit 0 || exit 4 ;;
      esac
    fi
    if [ -e "$DISABLED" ]; then
      echo "POWERPC_CONTROL=DISABLED"
      exit 3
    fi
    echo "POWERPC_CONTROL=STOPPED"
    exit 1
    ;;
  restart)
    mkdir -p "$STATE"
    chmod 700 "$STATE"
    rm -f "$DISABLED"
    exec 9>"$LOCKFILE"
    if command -v flock >/dev/null 2>&1; then flock 9; fi
    stop_one
    start_one
    ;;
  stop|disable)
    mkdir -p "$STATE"
    chmod 700 "$STATE"
    : >"$DISABLED"
    chmod 600 "$DISABLED"
    exec 9>"$LOCKFILE"
    if command -v flock >/dev/null 2>&1; then flock 9; fi
    stop_one
    ;;
  *)
    echo "usage: $0 [ensure|start|enable|status|restart|stop|disable]" >&2
    exit 2
    ;;
esac
