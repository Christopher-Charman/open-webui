#!/bin/sh
set -eu
umask 077

ACCOUNT="/home/storage/781/4477781/user"
WEBAPP="$ACCOUNT/webapp"
STATE="$ACCOUNT/.powerpc-control-workers"
SUPERVISOR="$STATE/control-plane-workers.py"
PIDFILE="$STATE/supervisor.pid"
STATUSFILE="$STATE/status.json"
DISABLED="$STATE/disabled"
LOCKFILE="$STATE/service.lock"
LOG="$STATE/service.log"

PY=""
for p in \
  "$WEBAPP/miniconda/bin/python3.12" \
  "$WEBAPP/miniconda/bin/python3" \
  "$WEBAPP/envs/open-terminal/bin/python"
do
  if [ -x "$p" ]; then PY="$p"; break; fi
done
[ -n "$PY" ] || { echo "python runtime unavailable" >&2; exit 2; }

alive() {
  [ -s "$PIDFILE" ] || return 1
  pid="$(cat "$PIDFILE" 2>/dev/null || true)"
  [ -n "$pid" ] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  [ -r "/proc/$pid/cmdline" ] || return 1
  tr '\\000' ' ' <"/proc/$pid/cmdline" | grep -F -- "$SUPERVISOR" >/dev/null 2>&1
}

wait_alive() {
  n=0
  while [ "$n" -lt 30 ]; do
    if alive; then return 0; fi
    n=$((n+1))
    sleep 1
  done
  return 1
}

stop_one() {
  if alive; then
    pid="$(cat "$PIDFILE")"
    kill "$pid" 2>/dev/null || true
    n=0
    while kill -0 "$pid" 2>/dev/null && [ "$n" -lt 15 ]; do
      n=$((n+1))
      sleep 1
    done
    if kill -0 "$pid" 2>/dev/null && [ -r "/proc/$pid/cmdline" ] && \
       tr '\\000' ' ' <"/proc/$pid/cmdline" | grep -F -- "$SUPERVISOR" >/dev/null 2>&1; then
      kill -9 "$pid" 2>/dev/null || true
    fi
  fi
  rm -f "$PIDFILE"
}

start_one() {
  [ -x "$SUPERVISOR" ] || { echo "worker supervisor missing: $SUPERVISOR" >&2; return 2; }
  mkdir -p "$STATE"
  chmod 700 "$STATE"
  rm -f "$DISABLED"
  if alive; then return 0; fi
  rm -f "$PIDFILE"
  (
    exec 9>&-
    cd "$WEBAPP"
    if command -v setsid >/dev/null 2>&1; then
      exec setsid "$PY" "$SUPERVISOR"
    else
      exec "$PY" "$SUPERVISOR"
    fi
  ) </dev/null >>"$LOG" 2>&1 &
  wait_alive
}

do_ensure() {
  [ ! -e "$DISABLED" ] || return 0
  mkdir -p "$STATE"
  chmod 700 "$STATE"
  exec 9>"$LOCKFILE"
  if command -v flock >/dev/null 2>&1; then
    flock -n 9 || return 0
  fi
  if alive; then return 0; fi
  start_one
}

case "${1:-ensure}" in
  ensure)
    do_ensure
    ;;
  start|enable)
    mkdir -p "$STATE"
    chmod 700 "$STATE"
    rm -f "$DISABLED"
    do_ensure
    ;;
  status)
    if alive; then
      echo "POWERPC_CONTROL_WORKERS=RUNNING pid=$(cat "$PIDFILE")"
      if [ -s "$STATUSFILE" ]; then
        "$PY" - "$STATUSFILE" <<'PY'
import json,sys,time
p=sys.argv[1]
try:
    d=json.load(open(p))
    age=max(0,int(time.time())-int(d.get("heartbeat_at",0)))
    print("heartbeat_age=%d" % age)
    print("state=%s" % d.get("state","unknown"))
    t=d.get("tunnel_client",{})
    b=d.get("continuity_bridge",{})
    print("tunnel_health=%s" % t.get("health","unknown"))
    print("tunnel_process_alive=%s" % str(bool(t.get("process_alive"))).lower())
    print("bridge_health=%s" % b.get("health","unknown"))
    print("bridge_process_alive=%s" % str(bool(b.get("process_alive"))).lower())
    print("local_mcp_mode=%s" % d.get("local_mcp_mode","unknown"))
except Exception:
    print("status_json=UNREADABLE")
PY
      fi
      exit 0
    fi
    if [ -e "$DISABLED" ]; then
      echo "POWERPC_CONTROL_WORKERS=DISABLED"
      exit 3
    fi
    echo "POWERPC_CONTROL_WORKERS=STOPPED"
    exit 1
    ;;
  restart)
    mkdir -p "$STATE"
    chmod 700 "$STATE"
    rm -f "$DISABLED"
    exec 9>"$LOCKFILE"
    if command -v flock >/dev/null 2>&1; then flock 9; fi
    stop_one
    start_one
    ;;
  stop|disable)
    mkdir -p "$STATE"
    chmod 700 "$STATE"
    : >"$DISABLED"
    chmod 600 "$DISABLED"
    exec 9>"$LOCKFILE"
    if command -v flock >/dev/null 2>&1; then flock 9; fi
    stop_one
    ;;
  *)
    echo "usage: $0 [ensure|start|enable|status|restart|stop|disable]" >&2
    exit 2
    ;;
esac
